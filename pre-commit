#!/bin/sh
set -eu

project_dir=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
build_dir="$project_dir/.build/pre-commit"

cmake -S "$project_dir" -B "$build_dir" \
    -DCMAKE_BUILD_TYPE=Debug \
    -DBUILD_TESTING=ON
cmake --build "$build_dir" --parallel

if ! command -v clang-format >/dev/null 2>&1; then
    printf '%s\n' "clang-format is required for the pre-commit check." >&2
    exit 1
fi

clang-format --dry-run --Werror \
    "$project_dir/library.cpp" \
    "$project_dir/library.h" \
    "$project_dir/main.cpp" \
    "$project_dir/library_unit_tests.cpp" \
    "$project_dir/library_regression_tests.cpp" \
    "$project_dir/provided_coverage.h"

if ! command -v clang-tidy >/dev/null 2>&1; then
    printf '%s\n' "clang-tidy is required for the pre-commit check." >&2
    exit 1
fi

clang-tidy -p "$build_dir" --warnings-as-errors='bugprone-*' \
    "$project_dir/library.cpp" \
    "$project_dir/main.cpp" \
    "$project_dir/library_unit_tests.cpp" \
    "$project_dir/library_regression_tests.cpp"
